# ═══════════════════════════════════════════════════════════════════════════════
# ReQuote – Production Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production (or configure directly in Render / Vercel dashboard).
# NEVER commit production credentials or actual .env files into version control.

# ── Application Settings ──────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
# Maximum request body size limit in bytes (2 MB default)
MAX_REQUEST_BODY_BYTES=2097152

# ── Database (Neon / Supabase / Managed PostgreSQL) ───────────────────────────
# For Neon / Supabase, paste your pooled connection string with SSL required.
# Alembic and the backend automatically handle postgres:// and asyncpg driver prefixes.
# Example Neon:     postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/requote?sslmode=require
# Example Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:strong_password@host:5432/database?sslmode=require

# ── Authentication / Security ─────────────────────────────────────────────────
# Generate a cryptographically secure 64+ char secret key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_64_character_hex_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# Comma-separated list or JSON array of allowed frontend domain URLs.
# Must include your production Vercel frontend URL (without trailing slash).
CORS_ORIGINS=https://requote-frontend.vercel.app,http://localhost:5173

# ── Business Details (Quotation PDF Header Defaults) ──────────────────────────
# Users can also customize these per-account in the Settings page.
BUSINESS_NAME=ReQuote Solutions
BUSINESS_EMAIL=contact@requote.io
BUSINESS_PHONE=+1 (555) 019-2834
BUSINESS_ADDRESS=100 Innovation Way, Suite 500, San Francisco, CA 94105
BUSINESS_WEBSITE=https://requote.io

# ── Frontend Environment Variable (Set in Vercel Dashboard) ───────────────────
# Point to your Render backend API service (with or without /api suffix)
# VITE_API_URL=https://requote-api.onrender.com/api

