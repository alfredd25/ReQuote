# ── ReQuote Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Database
POSTGRES_DB=requote
POSTGRES_USER=requote
POSTGRES_PASSWORD=changeme_use_a_strong_password

# Full DATABASE_URL — used by SQLAlchemy (app) and Alembic (migrations)
# Inside Docker Compose the host is "db"; locally use "localhost"
DATABASE_URL=postgresql://requote:changeme_use_a_strong_password@db:5432/requote

# Application
APP_ENV=development
DEBUG=false

# Authentication / JWT
JWT_SECRET_KEY=changeme_generate_a_secure_random_key_at_least_32_bytes_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business Details (Quotation PDF Header)
BUSINESS_NAME=ReQuote Solutions
BUSINESS_EMAIL=contact@requote.io
BUSINESS_PHONE=+1 (555) 019-2834
BUSINESS_ADDRESS=100 Innovation Way, Suite 500, San Francisco, CA 94105
BUSINESS_WEBSITE=https://requote.io

# CORS (comma-separated origins for production)
# CORS_ORIGINS=["https://yourdomain.com"]

# Frontend (optional — defaults to /api proxy in development and production)
# VITE_API_URL=http://localhost:8000

